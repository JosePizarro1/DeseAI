# Las dos primeras variables se obtienen de Supabase > Project Settings > API.
# URL + publishable/anon key son datos públicos del cliente (NO usar service_role).
NEXT_PUBLIC_SUPABASE_URL=https://TU_PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=TU_SUPABASE_PUBLISHABLE_KEY

# Solo para el servidor. Nunca empieces este nombre por NEXT_PUBLIC_.
OPENAI_API_KEY=TU_CLAVE_SECRETA
# Modelos configurables; los valores recomendados ya están en el código.
OPENAI_WISH_MODEL=gpt-4.1-mini
OPENAI_EMBED_MODEL=text-embedding-3-small

# V18: PayPal SOLO SANDBOX. Client ID público, Secret estrictamente privado.
NEXT_PUBLIC_PAYPAL_SANDBOX_CLIENT_ID=TU_CLIENT_ID_SANDBOX
PAYPAL_SANDBOX_CLIENT_SECRET=TU_SECRET_SANDBOX
PAYPAL_WEBHOOK_ID=TU_WEBHOOK_ID_SANDBOX

# Solo servidor, requerida para órdenes y webhooks (nunca NEXT_PUBLIC_).
SUPABASE_SERVICE_ROLE_KEY=TU_SERVICE_ROLE_KEY

# Interpretación de deseos con Qwen en Groq (solo servidor).
GROQ_API_KEY=
GROQ_WISH_MODEL=qwen/qwen3.8-27b
